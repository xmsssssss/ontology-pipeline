GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=regulation
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_TIMEOUT=20
KB_WORKSPACE=workspace

# AI extraction (OpenAI-compatible /chat/completions API)
# These values seed the service. Non-sensitive settings can also be edited in
# the Web build page and are persisted in workspace/config/ai_settings.json.
# AI_API_KEY is never written to that file.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
# Base URL such as https://api.openai.com/v1, http://localhost:11434/v1,
# or a full .../chat/completions endpoint.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_BATCH_SIZE=8
AI_CONCURRENCY=2
AI_TIMEOUT=60
AI_MAX_RETRIES=2
# spires: entity grounding followed by relation extraction (recommended)
# single_pass: legacy one-call JSON extraction
AI_EXTRACTION_STRATEGY=spires
